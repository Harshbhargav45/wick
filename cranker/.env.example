# --- RPC ---------------------------------------------------------------
# The public devnet endpoint rate-limits a 5s tick loop: once 429s start, the
# guard's staleness window (MAX_TICK_AGE_SECS, 10s) closes before a tick lands
# and it flips to degraded. Configure at least one keyed endpoint. Endpoints are
# tried in order and a rate-limit or transport failure rotates to the next one.
#
# Run `npm run rpc-check` after editing: it proves every endpoint is reachable
# AND serving the cluster below, by genesis hash.

# Cluster this cranker is bound to: devnet | mainnet-beta | testnet.
# Endpoints whose host names a DIFFERENT cluster are rejected at startup with a
# reason. This is the check that matters most in practice: provider dashboards
# hand out a mainnet URL by default, and a mainnet endpoint on a devnet deploy
# does not fail — it answers every query about a chain the guard is not on, so
# the loop logs "no guard accounts found" forever and looks like a program bug.
SOLANA_CLUSTER=devnet

# Helius free tier: https://dashboard.helius.dev — paste just the key. The host
# is built from SOLANA_CLUSTER, so one key works on any cluster.
HELIUS_API_KEY=
# Or the full URL, if you prefer (takes the key's place). Must match the cluster.
# HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=...
#
# QuickNode free tier: https://dashboard.quicknode.com — the endpoint must be
# provisioned for the cluster above. A mainnet URL here is rejected on devnet.
QUICKNODE_RPC_URL=

# Single override, kept for compatibility. Inserted ahead of public devnet.
SOLANA_RPC=https://api.devnet.solana.com

# Full explicit priority list (comma-separated). Wins over everything above.
# SOLANA_RPC_ENDPOINTS=https://devnet.helius-rpc.com/?api-key=...,https://api.devnet.solana.com

# Fee payer + guard owner (cranker signer).
# Defaults to ~/.config/solana/id.json when unset.
CRANKER_KEYPAIR=/absolute/path/to/keypair.json

# Pyth Hermes endpoint (legacy, no API key required until the Pyth Core upgrade)
HERMES_BASE_URL=https://hermes.pyth.network

# Pyth program IDs (devnet defaults). Note the Wormhole id contains `Yoz3zr8`:
# the same address with the `z` dropped ALSO decodes to a valid 32-byte key, so
# a typo here does not throw — it silently points at a different program.
PYTH_RECEIVER_PROGRAM_ID=rec5EKMGg6MxZYaMdyBfgwp4d5rB9T1VQH5pJv5LtFJ
WORMHOLE_PROGRAM_ID=HDwcJBJXjL9FpJ7UBsYBtaDjsBUhuLCUYoz3zr8SWWaQ

# Wick on-chain program id
WICK_PROGRAM_ID=FRtyvM3xcFhL5FbukUdzaMV7t4pePiqxPvp2ZHwptBE

# --- MagicBlock Ephemeral Rollup (§8.6) --------------------------------
# Base-layer RPC is above; these are the ER endpoints the delegated guard ticks
# against. The router picks a validator; the direct endpoint pins one.
MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app
MAGICBLOCK_ER_URL=https://devnet.magicblock.app

# Tick cadence in milliseconds
TICK_INTERVAL_MS=5000

# §8.3 — venue reconciliation cadence, in milliseconds. Reconciliation is a
# correction to the guard's model, not part of the heartbeat, so it runs far
# slower than the tick: putting it on the tick's path would spend the same
# staleness budget the 10s MAX_TICK_AGE_SECS window measures. Only Drift guards
# have a venue account the program can decode, so this is a no-op for others.
RECONCILE_INTERVAL_MS=60000

# §8.5 — withdrawing from the margin reserve is 2-of-2 (owner + co-authority),
# so `margin-wallet.mjs withdraw` needs a second keypair. Path only, never an
# inline secret. Not needed for init/fund/status.
CO_AUTHORITY_KEYPAIR=/absolute/path/to/co-authority.json

# Optional: pin a specific feed. SOL/USD is the only supported feed today.
PYTH_FEED_ID=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d

# 1 = simulate only (build + log, no send). 0 = send real transactions.
DRY_RUN=1